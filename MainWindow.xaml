<Window x:Class="ModernInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Process Injector Pro" Height="720" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" 
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Domyślne kolory (Tryb Ciemny) -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#121214"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1A1A1E"/>
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#25252B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9EA8"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E2E38"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#25252B"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#32323B"/>
        <SolidColorBrush x:Key="ConsoleFgBrush" Color="#4EC9B0"/>
        <SolidColorBrush x:Key="PidColorBrush" Color="#4EC9B0"/>
        <SolidColorBrush x:Key="RamColorBrush" Color="#E5C07B"/>

        <!-- Styl dla standardowych przycisków -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1C21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Specjalny niezależny styl dla przycisku akcji krytycznych (Zabij proces) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5A1D1D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#8C2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6E2424"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A33838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#451414"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="toggleButton" Grid.ColumnSpan="2" Background="Transparent" BorderBrush="Transparent" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="contentPresenter" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding SelectionBoxItem}"/>
                                    <Path x:Name="arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}" Width="8" Height="4"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" PopupAnimation="Slide" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                                <Border x:Name="dropDownBorder" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="2">
                                        <ItemsPresenter x:Name="ItemsPresenter"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl ListBoxItem -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1" Padding="6,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PROCESS INJECTOR" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Zaawansowane narzędzie z konsolą diagnostyczną i zarządzaniem" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="BtnThemeToggle" Content="☀️ Jasny Motyw" Click="BtnThemeToggle_Click" HorizontalAlignment="Right" Width="130" Height="32"/>
        </Grid>

        <!-- Wyszukiwarka, Metoda, Odświeżanie -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>

            <!-- Pole wyszukiwania z napisem Wyszukaj... -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="TxtSearch" Height="34" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Padding="10,0" TextChanged="TxtSearch_TextChanged"/>
                <TextBlock Text="Wyszukaj proces..." Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox x:Name="CbMethod" Grid.Column="1" Height="34" Margin="0,0,10,0">
                <ComboBoxItem Content="Standard Injection" IsSelected="True"/>
                <ComboBoxItem Content="Thread Hijacking"/>
                <ComboBoxItem Content="LdrLoadDll Stub"/>
                <ComboBoxItem Content="Manual Map"/>
            </ComboBox>
            <Button x:Name="BtnRefresh" Grid.Column="2" Content="Odśwież" Click="BtnRefresh_Click" Height="34"/>
        </Grid>

        <!-- Lista procesów -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
            <ListBox x:Name="LbProcesses" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" SelectionChanged="LbProcesses_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PID: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Id}" Foreground="{DynamicResource PidColorBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <TextBlock Text="RAM: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding MemorySize}" Foreground="{DynamicResource RamColorBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Panel dodatkowy: Licznik + Auto-odświeżanie + Zabij proces -->
        <Grid Grid.Row="3" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtProcessCount" Grid.Column="0" Text="Znaleziono procesów: 0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkAutoRefresh" Grid.Column="1" Content="Auto-odświeżanie (3s)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0" Checked="ChkAutoRefresh_Checked" Unchecked="ChkAutoRefresh_Unchecked"/>

            <!-- Zastosowany dedykowany styl odporny na zmiany motywu -->
            <Button x:Name="BtnKillProcess" Grid.Column="2" Content="Zabij zaznaczony proces" Click="BtnKillProcess_Click" Width="150" Height="26" FontSize="11" Style="{StaticResource DangerButtonStyle}"/>
        </Grid>

        <!-- Konsola logów diagnostycznych -->
        <Border Grid.Row="4" Background="{DynamicResource InputBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Konsola diagnostyczna logów:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,4"/>
                <TextBox x:Name="TxtConsoleLogs" IsReadOnly="True" AcceptsReturn="True" Background="Transparent" Foreground="{DynamicResource ConsoleFgBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- Ścieżka DLL -->
        <Grid Grid.Row="5" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtDllPath" IsReadOnly="True" Height="36" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,10,0"/>
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Wybierz DLL" Click="BtnBrowse_Click" Width="120" Height="36" Background="#007ACC" BorderBrush="#007ACC" Foreground="White" FontWeight="Medium"/>
        </Grid>

        <!-- Przycisk wstrzykiwania -->
        <Button x:Name="BtnInject" Grid.Row="6" Content="WSTRZYKNIJ PLIK DLL" Click="BtnInject_Click" Height="42" Background="#0E7052" BorderBrush="#12966C" Foreground="White" FontWeight="Bold" FontSize="13"/>
    </Grid>
</Window>